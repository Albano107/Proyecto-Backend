meta {
  name: Registrar retiro (inventario inexistente)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/retiros
  body: json
  auth: none
}

body:json {
  {
    "id_inventario": 999999,
    "cantidad": 1,
    "motivo": "Vencimiento",
    "id_usuario": {{id_usuario}}
  }
}

assert {
  res.status: eq 404
}
